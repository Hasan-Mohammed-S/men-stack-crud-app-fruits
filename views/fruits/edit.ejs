<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit
        <%= fruit.name %>
    </title>
</head>


<body>
    <h1>Edit
        <%= fruit.name %>
    </h1>
    <a href="/fruits/">Back to Fruits</a>
    <form action="/fruits/<%=fruit._id%>?_method=PUT" method="POST">
        <label for="name">Naxme:</label>
        <input type="text" name="name" id="name" value="<%= fruit.name %>" />

        <label for="isReadyToEat">Ready to Eat?</label>
        <input type="checkbox" name="isReadyToEat" id="isReadyToEat" <% if (fruit.isReadyToEat) { %>checked
        <% } %> />

            <button type="submit">Update Fruit</button>
    </form>
</body>

</html>